{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test src/**/*.test.js src/**/**/*.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test accessibility.spec.js",
    "test:e2e:compatibility": "playwright test --config playwright.compatibility.config.js",
    "test:e2e:external": "playwright test --config playwright.external.config.js public-readiness.spec.js",
    "test:e2e:external:authenticated": "playwright test --config playwright.external.config.js authenticated-readonly.spec.js",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:components",
    "test:coverage:unit": "c8 --all --check-coverage --statements=19 --branches=60 --functions=40 --lines=19 --reporter=lcov --reporter=text-summary --reports-dir=coverage/unit --include='src/**/*.js' --exclude='src/**/*.test.js' --exclude='src/**/hooks/*.js' node --test src/**/*.test.js src/**/**/*.test.js",
    "test:coverage:components": "vitest run --config vitest.config.js --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.72.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.4",
    "vitest": "^5.0.0"
  }
}
